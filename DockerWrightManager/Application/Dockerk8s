FROM mcr.microsoft.com/dotnet/core/sdk:3.1 AS build-env
WORKDIR /Application
COPY . .
RUN dotnet restore DockerWrightManager.sln 

RUN dotnet publish DockerWrightManager.sln -c Release -o out

FROM mcr.microsoft.com/dotnet/core/aspnet:3.1
WORKDIR /Application
COPY --from=build-env /Application/out .
ENTRYPOINT ["dotnet", "DockerWrightManager.dll"]